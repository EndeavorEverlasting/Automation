{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-agent-readiness-profile/v1",
  "title": "Local agent readiness profile",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "projection_sets",
    "agents",
    "remote_write"
  ],
  "properties": {
    "schema_version": {
      "const": "local-agent-readiness-profile/v1"
    },
    "repository": {
      "type": "object",
      "required": ["remote", "baseline_branch"],
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "baseline_branch": {
          "type": "string",
          "minLength": 1
        },
        "remote_identity": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "projection_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "projection_sets",
          "required_gates",
          "runtime_claims_required"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "projection_sets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "REPOSITORY_CHECKOUT_CURRENT",
                "AGENT_PROJECTION_MATCHES_BASELINE",
                "LOCAL_AGENT_RUNTIME_VERIFIED",
                "REMOTE_WRITE_VERIFIED",
                "ACTUAL_PUSH_PROVEN"
              ]
            }
          },
          "runtime_claims_required": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "remote_write": {
      "type": "object",
      "required": ["dry_run_namespace"],
      "properties": {
        "dry_run_namespace": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
