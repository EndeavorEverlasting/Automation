{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-formatting-plan/v1",
  "title": "Document Formatting Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "consumer_id",
    "profile_id",
    "consumer_contract_ref",
    "profile_sha256",
    "state",
    "prevent_proof_promotion",
    "stages",
    "terminal_dependencies",
    "proof_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "document-formatting-plan/v1"
    },
    "capability_id": {
      "const": "document-formatting"
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "consumer_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "const": "PLAN_READY"
    },
    "prevent_proof_promotion": {
      "type": "boolean"
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "execution_environment",
          "depends_on",
          "proof_ceiling"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_environment": {
            "enum": [
              "CURRENT_CHAT_RUNTIME",
              "LOCAL_AGENT_RUNTIME",
              "CI_OR_REMOTE_RUNNER",
              "OPERATOR_OR_PHYSICAL_RUNTIME",
              "UNKNOWN_RUNTIME"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terminal_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "proof_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
