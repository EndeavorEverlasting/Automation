{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-formatting-source/v1",
  "type": "object",
  "required": [
    "schema_version",
    "archetype",
    "title",
    "metadata",
    "resources",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "document-formatting-source/v1"
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\\\s<>()]+$"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              1,
              2
            ]
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/textBlock"
                },
                {
                  "$ref": "#/$defs/commandBlock"
                },
                {
                  "$ref": "#/$defs/bulletBlock"
                },
                {
                  "$ref": "#/$defs/tableBlock"
                },
                {
                  "$ref": "#/$defs/imageBlock"
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "textBlock": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "warning",
            "evidence",
            "signature_line"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandBlock": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bulletBlock": {
      "type": "object",
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "bullet_list"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": [
        "type",
        "headers",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "required": [
        "type",
        "asset_ref",
        "alt_text"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "alt_text": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
