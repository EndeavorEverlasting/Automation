{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-formatting-source/v1",
  "type": "object",
  "required": [
    "schema_version",
    "archetype",
    "title",
    "metadata",
    "resources",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "document-formatting-source/v1"
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "metadata": {
      "type": "array"
    },
    "resources": {
      "type": "array"
    },
    "sections": {
      "type": "array",
      "minItems": 1
    }
  }
}
