{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-formatting-design-spec/v1",
  "type": "object",
  "required": [
    "schema_version",
    "spec_id",
    "page_mechanics",
    "palette",
    "roles",
    "frame_roles",
    "block_component_map",
    "archetypes"
  ],
  "properties": {
    "schema_version": {
      "const": "document-formatting-design-spec/v1"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "page_mechanics": {
      "type": "object"
    },
    "palette": {
      "type": "object",
      "minProperties": 1
    },
    "roles": {
      "type": "object",
      "minProperties": 1
    },
    "frame_roles": {
      "type": "object"
    },
    "block_component_map": {
      "type": "object"
    },
    "archetypes": {
      "type": "object",
      "minProperties": 1
    }
  }
}
