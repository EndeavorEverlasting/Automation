{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-runtime-route-decision/v1",
  "title": "Agent runtime route decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "work_unit_id", "selected_adapter_id", "evaluations", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "agent-runtime-route-decision/v1"},
    "state": {"enum": ["SELECTED", "BLOCKED"]},
    "work_unit_id": {"type": "string", "minLength": 1},
    "selected_adapter_id": {"type": ["string", "null"]},
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter_id", "profile", "admission"],
        "properties": {
          "adapter_id": {"type": "string", "minLength": 1},
          "profile": {"type": "object"},
          "admission": {"type": "object"}
        }
      }
    },
    "proof_ceiling": {"type": "string", "minLength": 1}
  }
}
