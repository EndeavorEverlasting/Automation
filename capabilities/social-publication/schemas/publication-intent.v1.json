{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation://social-publication/publication-intent.v1",
  "title": "Social Publication Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "content",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "const": "social-publication-intent/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PUBLIC"
      ]
    }
  }
}
