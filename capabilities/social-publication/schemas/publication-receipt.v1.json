{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation://social-publication/publication-receipt.v1",
  "title": "Social Publication Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "state",
    "content_sha256",
    "provider_request_state",
    "provider_post_id"
  ],
  "properties": {
    "schema_version": {
      "const": "social-publication-receipt/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "state": {
      "type": "string",
      "enum": [
        "PREVIEW_READY",
        "BLOCKED_APPROVAL_REQUIRED",
        "BLOCKED_STALE_APPROVAL",
        "PROVIDER_REQUEST_BUILD_FAILED",
        "PROVIDER_TRANSPORT_FAILED",
        "PROVIDER_RESPONSE_INCOMPLETE",
        "PUBLISHED",
        "PROVIDER_AUTHORIZATION_FAILED",
        "PROVIDER_REJECTED"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_request_state": {
      "type": "string",
      "enum": [
        "NOT_EMITTED",
        "EMITTED",
        "UNKNOWN"
      ]
    },
    "provider_post_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_status_code": {
      "type": "integer"
    },
    "error_class": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PREVIEW_READY",
              "BLOCKED_APPROVAL_REQUIRED",
              "BLOCKED_STALE_APPROVAL",
              "PROVIDER_REQUEST_BUILD_FAILED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_request_state": {
            "const": "NOT_EMITTED"
          },
          "provider_post_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PROVIDER_TRANSPORT_FAILED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_request_state": {
            "const": "UNKNOWN"
          },
          "provider_post_id": {
            "type": "null"
          }
        },
        "required": [
          "error_class"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PROVIDER_RESPONSE_INCOMPLETE",
              "PUBLISHED",
              "PROVIDER_AUTHORIZATION_FAILED",
              "PROVIDER_REJECTED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_request_state": {
            "const": "EMITTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PUBLISHED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_post_id": {
            "type": "string",
            "minLength": 1
          },
          "provider_request_state": {
            "const": "EMITTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PROVIDER_REQUEST_BUILD_FAILED",
              "PROVIDER_TRANSPORT_FAILED",
              "PROVIDER_RESPONSE_INCOMPLETE",
              "PROVIDER_AUTHORIZATION_FAILED",
              "PROVIDER_REJECTED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "error_class"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "PUBLISHED"
            }
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "provider_post_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
