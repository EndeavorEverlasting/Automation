{
  "schema_version": "automation-runtime-execution-handoff/v1",
  "packet_schema_version": "automation-runtime-handoff-packet/v1",
  "semantic_dependency": "planning.runtime_partition",
  "corporate_boundary_dependency": "tokencorridor-chatgpt-corporate-access-admission/v1",
  "role": "consumer_validation_only",
  "description": "Execution-facing handoff validation for deterministic runtime placement. This contract consumes an upstream placement decision; it does not plan work, broker execution, or choose ownership.",
  "corporate_boundary": {
    "chatgpt_corporate_provider_access": "DENY",
    "personal_workstation_corporate_access": "PERMIT_WHEN_COMPANY_APPROVED",
    "local_agent_corporate_access": "PERMIT_WHEN_AUTHORIZED_AND_ISOLATED",
    "unknown_corporate_access": "DENY",
    "chatgpt_environments": [
      "CURRENT_CHAT_RUNTIME",
      "CONNECTED_PROVIDER"
    ],
    "corporate_provider_families": [
      "microsoft_365",
      "m365",
      "outlook",
      "teams",
      "sharepoint",
      "onedrive",
      "azure_ad",
      "entra_id",
      "servicenow",
      "corporate_identity",
      "corporate_email",
      "corporate_calendar",
      "corporate_directory",
      "corporate_hr",
      "badge_portal",
      "nyc_hh",
      "nychealthhospitals",
      "hh_fieldops",
      "company_portal"
    ],
    "rule": "READY packets that place ChatGPT/CURRENT_CHAT_RUNTIME or CONNECTED_PROVIDER against corporate provider families are rejected. OPERATOR_OR_PHYSICAL_RUNTIME corporate access remains admissible. LOCAL_AGENT_RUNTIME corporate access requires operator_authorized=true, company_policy_permits=true, and credentials_exported_to_chatgpt=false. Missing provider_access remains valid for non-corporate packets."
  },
  "execution_environments": [
    "CURRENT_CHAT_RUNTIME",
    "CONNECTED_PROVIDER",
    "LOCAL_AGENT_RUNTIME",
    "CI_OR_REMOTE_RUNNER",
    "OPERATOR_OR_PHYSICAL_RUNTIME",
    "UNKNOWN_RUNTIME"
  ],
  "packet_states": [
    "READY",
    "BLOCKED",
    "COMPLETE"
  ],
  "required_fields": [
    "schema_version",
    "packet_state",
    "work_unit_id",
    "semantic_owner",
    "execution_environment",
    "required_capabilities",
    "mutation_authority",
    "owned_scope",
    "forbidden_scope",
    "evidence_inputs",
    "dependencies",
    "collision_surface",
    "expected_artifacts",
    "acceptance_gates",
    "proof_ceiling",
    "runtime_handoff",
    "freshness_requirements"
  ],
  "nonempty_string_fields": [
    "work_unit_id",
    "semantic_owner",
    "execution_environment",
    "proof_ceiling",
    "runtime_handoff"
  ],
  "nonempty_list_fields": [
    "required_capabilities",
    "mutation_authority",
    "owned_scope",
    "forbidden_scope",
    "evidence_inputs",
    "expected_artifacts",
    "acceptance_gates",
    "freshness_requirements"
  ],
  "ready_rules": {
    "forbid_unknown_runtime": true,
    "require_nonempty_dependencies": false,
    "require_nonempty_collision_surface": false
  },
  "privacy": {
    "forbidden_key_fragments": [
      "drive_url",
      "drive_file_id",
      "drive_folder_id",
      "google_drive",
      "access_token",
      "refresh_token",
      "password",
      "cookie",
      "browser_profile_path",
      "api_key",
      "secret",
      "credential",
      "session",
      "browser_state",
      "private_key",
      "authorization",
      "token",
      "auth_header"
    ],
    "forbidden_string_patterns": [
      "drive.google.com/",
      "docs.google.com/document/",
      "docs.google.com/spreadsheets/",
      "docs.google.com/presentation/"
    ],
    "forbidden_string_regexes": [
      "(?i)[A-Z]:[\\\\\\\\/]Users[\\\\\\\\/][^\\\\\\\\/]+[\\\\\\\\/]",
      "/home/[^/]+/",
      "/Users/[^/]+/"
    ],
    "rule": "Tracked public packets must use semantic inputs, sanitized evidence, repository-relative paths, synthetic fixtures, and public provenance. Private locator mappings stay outside public Git."
  },
  "local_executor_invariants": [
    "Local executors consume READY packets; they do not decide canonical ownership or broaden scope.",
    "A packet must carry enough evidence to avoid rediscovery except where freshness_requirements explicitly require revalidation.",
    "A failed acceptance gate remains failed until diagnosed and rerun; it is not a completion claim.",
    "No packet may assume frontier-model reasoning quality.",
    "UNKNOWN_RUNTIME is an owner/capability-resolution state, not an executable placement."
  ],
  "proof_states": [
    "DESIGNED",
    "IMPLEMENTED",
    "LOCALLY_VALIDATED",
    "INTEGRATION_VALIDATED",
    "COMMITTED",
    "PUSHED",
    "MERGED",
    "DEPLOYED",
    "PRODUCTION_VERIFIED"
  ],
  "list_fields": [
    "required_capabilities",
    "mutation_authority",
    "owned_scope",
    "forbidden_scope",
    "evidence_inputs",
    "dependencies",
    "collision_surface",
    "expected_artifacts",
    "acceptance_gates",
    "freshness_requirements"
  ],
  "string_list_fields": [
    "required_capabilities",
    "mutation_authority",
    "owned_scope",
    "forbidden_scope",
    "dependencies",
    "collision_surface",
    "expected_artifacts",
    "acceptance_gates",
    "freshness_requirements"
  ],
  "evidence_input_required_fields": [
    "type",
    "identity"
  ]
}
